      "source": [
        "# Question 12\n",
        "a = [1,2,3]\n",
        "b = a\n",
        "b[0] = [99] # [99,1,2,3]\n",
        "a[0]  # [99]\n",
        "\n",
        "id(a) == id(b)  # True ,same memory idress becuase we point b to a"
      ],
      "id": "0qTAcSyYnC1-"
    },
    {
      "cell_type": "code",
