        "difference between arr.sort() vs sorted(arr)\n",
        "\n",
        "                |arr.sort()        |      |sorted(arr)\n",
        "                |__________________|\n",
        "return value    |                  |\n",
        "original modified               |                  |\n",
        "memory             |                  |\n",
        "speed             |                  |\n",
        "use case             |                  |\n",
