        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "[[99], 2, 3, 4]\n",
            "[[99], 2, 3, 4]\n",
            "[1, 2, 3, 4]\n"
          ]
        }
      ],
      "source": [
        "# muscle memory :reference vs copy drill 5x\n",
        "# [:] shallow copy\n",
        "# when we assign element to d list c is remain unchanged\n",
        "c = [1,2,3,4]\n",
        "d =c[:]\n",
        "d[0] = [99]\n",
        "print(d)\n",
        "# c # unchanged\n",
        "e = list(c)\n",
        "e[0]=[99]\n",
        "print(e) # chnaged\n",
        "print(c) # still unchanged\n",
        "\n"
      ]
    },
